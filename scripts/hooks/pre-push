#!/bin/bash
#
# Pre-push hook: blocks pushes of local main to origin/main unless an
# approved override env var is set. Local main may contain unreleased
# page code (NFL, NBA) that would auto-deploy to production via Vercel.
#
# This hook does NOT block the publish-main worktree's data pushes —
# those push HEAD:main from the publish-main branch, so local_ref is
# refs/heads/publish-main, not refs/heads/main.
#
# Override (any one of these):
#   NFL_GATE_MET=1 git push origin main
#   NBA_SITE_APPROVED=1 git push origin main
#
# Note: --no-verify bypasses all hooks including this one.
#
# Wire: git config core.hooksPath scripts/hooks
# Tracked: BFEv0.22.0 (September 8, 2026)
# Updated: BFEv0.35.0 (October 13, 2026) — added NBA_SITE_APPROVED

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
    # Only care about pushes TO refs/heads/main on origin
    if [ "$remote_ref" = "refs/heads/main" ]; then
        # Block if pushing LOCAL main (refs/heads/main) to origin/main,
        # regardless of which branch is currently checked out.
        if [ "$local_ref" = "refs/heads/main" ]; then
            # Check for any approved override
            override_label=""
            if [ "$NFL_GATE_MET" = "1" ]; then
                override_label="NFL_GATE_MET"
            elif [ "$NBA_SITE_APPROVED" = "1" ]; then
                override_label="NBA_SITE_APPROVED"
            fi

            if [ -n "$override_label" ]; then
                # Require interactive terminal unless _UNATTENDED is also set
                unattended_var="${override_label}_UNATTENDED"
                if [ ! -t 1 ] && [ "${!unattended_var}" != "1" ]; then
                    echo ""
                    echo "============================================================"
                    echo "  BLOCKED: override in non-interactive shell"
                    echo "============================================================"
                    echo ""
                    echo "  ${override_label}=1 requires an interactive terminal so the"
                    echo "  operator can review the diff summary before it ships."
                    echo ""
                    echo "  Run this in a terminal, not a background process:"
                    echo "    ${override_label}=1 git push origin main"
                    echo ""
                    echo "============================================================"
                    exit 1
                fi
                echo ""
                echo "[pre-push] ${override_label}=1 — override accepted."
                echo ""
                # Show diff summary so operator can abort if needed
                if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
                    commit_count=$(git rev-list --count "$remote_sha".."$local_sha" 2>/dev/null)
                    echo "  Pushing $commit_count commit(s) to origin/main."
                    echo ""
                    changed=$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null)
                    file_count=$(echo "$changed" | grep -c . 2>/dev/null)
                    echo "  Changed files ($file_count):"
                    echo "$changed" | head -15 | while IFS= read -r f; do echo "    $f"; done
                    [ "$file_count" -gt 15 ] && echo "    ... and $((file_count - 15)) more"
                    echo ""
                    # Show route changes
                    route_changes=$(git diff "$remote_sha".."$local_sha" -- src/App.js 2>/dev/null | grep '^[+-].*path=' | grep -v '^[+-][+-][+-]' || true)
                    if [ -n "$route_changes" ]; then
                        echo "  Route changes in App.js:"
                        echo "$route_changes" | while IFS= read -r line; do echo "    $line"; done
                        echo ""
                    fi
                fi
                echo "  Ctrl+C now to abort, or wait for push to proceed."
                echo ""
                exit 0
            fi

            echo ""
            echo "============================================================"
            echo "  BLOCKED: push of local main to origin/main"
            echo "============================================================"
            echo ""
            echo "  Local main contains unreleased page code that would"
            echo "  auto-deploy to production via Vercel."
            echo ""
            echo "  To push data-only from the publish worktree:"
            echo "    cd E:/Betrilo/betrilo-analytics-publish"
            echo "    git push origin HEAD:main"
            echo ""
            echo "  To override (approved code push):"
            echo "    NFL_GATE_MET=1 git push origin main"
            echo "    NBA_SITE_APPROVED=1 git push origin main"
            echo ""
            echo "  Note: --no-verify bypasses all git hooks including this one."
            echo ""
            echo "============================================================"
            exit 1
        fi

        # local_ref is NOT refs/heads/main — e.g. refs/heads/publish-main
        # via HEAD:main. These are data-only pushes. Allow.
    fi
done

exit 0
