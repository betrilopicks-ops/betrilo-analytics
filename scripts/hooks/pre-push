#!/bin/bash
#
# Pre-push hook: blocks ANY push to origin/main unless the local ref is
# publish-main (data pushes) or an approved override env var is set from
# an interactive terminal.
#
# This prevents accidental deploys of unreleased code to production via
# Vercel, regardless of which local branch is being pushed.
#
# Override (any one of these, from an interactive terminal):
#   NFL_GATE_MET=1 git push origin nba-launch:main
#   NBA_SITE_APPROVED=1 git push origin nba-launch:main
#
# Note: --no-verify bypasses all hooks including this one.
#
# Wire: git config core.hooksPath scripts/hooks
# Tracked: BFEv0.22.0 (September 8, 2026)
# Updated: BFEv0.35.1 (October 13, 2026) — blocks any branch to main,
#   not just local main. Added NBA_SITE_APPROVED.

remote="$1"
url="$2"

while read local_ref local_sha remote_ref remote_sha; do
    # Only care about pushes TO refs/heads/main on origin
    if [ "$remote_ref" != "refs/heads/main" ]; then
        continue
    fi

    # ALLOW: publish-main data pushes (HEAD:main from the publish worktree)
    if [ "$local_ref" = "refs/heads/publish-main" ]; then
        continue
    fi

    # Check for an approved override env var
    override_label=""
    if [ "$NFL_GATE_MET" = "1" ]; then
        override_label="NFL_GATE_MET"
    elif [ "$NBA_SITE_APPROVED" = "1" ]; then
        override_label="NBA_SITE_APPROVED"
    fi

    if [ -n "$override_label" ]; then
        # Require interactive terminal so the operator sees the summary
        if [ ! -t 1 ]; then
            echo ""
            echo "============================================================"
            echo "  BLOCKED: override in non-interactive shell"
            echo "============================================================"
            echo ""
            echo "  ${override_label}=1 requires an interactive terminal so the"
            echo "  operator can review the diff summary before it ships."
            echo ""
            echo "  Run this in a terminal, not a background process:"
            echo "    ${override_label}=1 git push origin ${local_ref#refs/heads/}:main"
            echo ""
            echo "============================================================"
            exit 1
        fi

        echo ""
        echo "[pre-push] ${override_label}=1 — override accepted."
        echo ""
        # Show diff summary so operator can abort if needed
        if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
            commit_count=$(git rev-list --count "$remote_sha".."$local_sha" 2>/dev/null)
            echo "  Pushing $commit_count commit(s) to origin/main."
            echo ""
            changed=$(git diff --name-only "$remote_sha".."$local_sha" 2>/dev/null)
            file_count=$(echo "$changed" | grep -c . 2>/dev/null)
            echo "  Changed files ($file_count):"
            echo "$changed" | head -15 | while IFS= read -r f; do echo "    $f"; done
            [ "$file_count" -gt 15 ] && echo "    ... and $((file_count - 15)) more"
            echo ""
            # Show route changes
            route_changes=$(git diff "$remote_sha".."$local_sha" -- src/App.js 2>/dev/null | grep '^[+-].*path=' | grep -v '^[+-][+-][+-]' || true)
            if [ -n "$route_changes" ]; then
                echo "  Route changes in App.js:"
                echo "$route_changes" | while IFS= read -r line; do echo "    $line"; done
                echo ""
            fi
        fi
        echo "  Ctrl+C now to abort, or wait for push to proceed."
        echo ""

        # CI build gate: a broken build blocks ALL data deploys (incident Oct 20 2026)
        if [ -f "package.json" ]; then
            echo "  Running CI=true npm run build..."
            if ! CI=true npm run build --silent 2>/dev/null; then
                echo ""
                echo "  ============================================"
                echo "  BLOCKED: CI build failed — fix before pushing"
                echo "  ============================================"
                exit 1
            fi
            echo "  Build passed."
            echo ""
        fi

        exit 0
    fi

    # BLOCK: no override, not publish-main
    branch_name="${local_ref#refs/heads/}"
    echo ""
    echo "============================================================"
    echo "  BLOCKED: push of ${branch_name} to origin/main"
    echo "============================================================"
    echo ""
    echo "  Pushing to origin/main auto-deploys to production via Vercel."
    echo "  All code pushes require an explicit override."
    echo ""
    echo "  To push data-only from the publish worktree:"
    echo "    cd E:/Betrilo/betrilo-analytics-publish"
    echo "    git push origin HEAD:main"
    echo ""
    echo "  To override (approved code push):"
    echo "    NFL_GATE_MET=1 git push origin ${branch_name}:main"
    echo "    NBA_SITE_APPROVED=1 git push origin ${branch_name}:main"
    echo ""
    echo "  Note: --no-verify bypasses all git hooks including this one."
    echo ""
    echo "============================================================"
    exit 1
done

exit 0
